  "item": [
    {
      "id": "0e7c3906-dd55-4ec4-8fce-65d2d69a895a",
      "name": "Accounts",
      "description": {
        "content": "Accounts represent the underlying store used to track balances\nand the transactions that have occurred to modify those balances\nover time. Up currently has three types of account: `SAVER`—used to\nearn interest and to hit savings goals, `TRANSACTIONAL`—used\nfor everyday spending, and `HOME_LOAN`-for those with an Up Home loan.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b38a6ed3-734f-4796-b20c-0668b25a96ac",
          "name": "List accounts",
          "request": {
            "name": "List accounts",
            "description": {
              "content": "Retrieve a paginated list of all accounts for the currently\nauthenticated user. The returned list is paginated and can be scrolled\nby following the `prev` and `next` links where present.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page[size]",
                  "value": "<integer>",
                  "description": "The number of records to return in each page.\n"
                },
                {
                  "disabled": false,
                  "key": "filter[accountType]",
                  "value": "<string>",
                  "description": "The type of account for which to return records. This\ncan be used to filter Savers from spending accounts.\n"
                },
                {
                  "disabled": false,
                  "key": "filter[ownershipType]",
                  "value": "<string>",
                  "description": "The account ownership structure for which to return\nrecords. This can be used to filter 2Up accounts from Up\naccounts.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
